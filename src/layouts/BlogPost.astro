---
import type {CollectionEntry} from "astro:content";
import RootLayout from "./RootLayout.astro";
import Card from "@/components/Card.astro";
import Comments from "@/components/Comments.astro";
import "../styles/article.scss";

type BlogData = CollectionEntry<"blog">["data"];

interface Props extends BlogData {
  wordCount?: number;
  readingTime?: number;
  relatedPosts?: CollectionEntry<"blog">[];
  prevPost?: CollectionEntry<"blog"> | null;
  nextPost?: CollectionEntry<"blog"> | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags,
  draft,
  wordCount,
  readingTime,
  relatedPosts = [],
  prevPost,
  nextPost,
} = Astro.props;
---

<RootLayout
  title={title}
  description={description}
  image={heroImage}
  width="lg"
>
  <div class="post-layout">
    <div class="post-main">
      <Card>
        {
          heroImage && (
                <img
                    src={heroImage}
                    alt={title}
                    loading="lazy"
                    class="hero-image"
                />
          )
        }
        <article id="article-content">
          <h1 class="emphasize">
            {title}
          </h1>
          <div class="meta">
            {
              draft && (
                    <p class="meta-text">
                      <span class="tag">Draft</span>
                    </p>
              )
            }
            <p class="meta-text">
                  <span>
                    Published:
                    {pubDate.toLocaleDateString()}
                  </span>
              {
                updatedDate && (
                      <>
                        <span>
                          Updated:
                          {updatedDate.toLocaleDateString()}
                        </span>
                      </>
                )
              }
            </p>
            {
              (readingTime || wordCount) && (
                    <p class="meta-text">
                      {readingTime && <span>{readingTime} min read</span>}
                      {wordCount && <span>{wordCount} words</span>}
                    </p>
              )
            }
            {
              tags && (
                    <p class="meta-text mini-tag-container">
                      tags:
                      {tags.map((tag) => (
                          <a href={`/tag/${tag}`}>{tag}</a>
                      ))}
                    </p>
              )
            }
            <p class="description">
              {description}
            </p>
          </div>
          <hr/>
          <slot/>
        </article>
      </Card>

      <nav class="post-nav">
        {
          prevPost ? (
                <a class="nav-card nav-prev" href={`/blog/${prevPost.id}`}>
                  <span class="nav-label">← Previous</span>
                  <span class="nav-title">{prevPost.data.title}</span>
                </a>
          ) : <span />
        }
        {
          nextPost ? (
                <a class="nav-card nav-next" href={`/blog/${nextPost.id}`}>
                  <span class="nav-label">Next →</span>
                  <span class="nav-title">{nextPost.data.title}</span>
                </a>
          ) : <span />
        }
      </nav>

      {
        relatedPosts.length > 0 && (
              <section class="related-section">
                <Card>
                  <h2>Related Posts</h2>
                </Card>
                <ul class="related-list">
                  {relatedPosts.map((post) => (
                      <li class="related-item">
                        <a class="related-btn" href={`/blog/${post.id}`}>
                          {post.data.title}
                          <span class="related-date">
                            {post.data.pubDate.toLocaleDateString()}
                          </span>
                        </a>
                      </li>
                  ))}
                </ul>
              </section>
        )
      }
      <Comments />
    </div>

  </div>
</RootLayout>

<style lang="scss">
  @use "@/styles/colors";

  .post-layout {
    display: flex;
    justify-content: center;
  }

  .post-main {
    width: 100%;
    max-width: 70rem;
    min-width: 0;
  }

  hr {
    border: none;
    background-color: var(--color-muted-foreground);
    margin-block: 0;
    height: 0.5px;
    margin: 1rem 0;
  }

  .meta {
    & > * {
      margin-block: 0;
    }

    .meta-text {
      display: flex;
      gap: 1rem;
      font-size: 0.8rem;
      flex-wrap: wrap;
    }

    .meta-text.mini-tag-container {
      gap: 0.5rem;
    }

    .description {
      font-size: 0.8rem;
    }
  }

  .hero-image {
    border-radius: 1rem;
    overflow: hidden;
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 21/9;
  }

  .related-section {
    margin-top: 2rem;

    h2 {
      margin: 0;
    }
  }

  .related-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .related-item {
    margin: 0;
    display: flex;
  }

  .related-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-card), transparent 30%);
    border: 1px solid color-mix(in srgb, var(--color-muted-foreground), transparent 70%);
    color: var(--color-foreground);
    text-decoration: none;
    font-size: 0.9rem;
    transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;

    &:hover {
      background-color: var(--color-primary-light);
      border-color: var(--color-primary);
      transform: translateY(-1px);
    }
  }

  .related-date {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
    }
  }

  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    border-radius: 0.75rem;
    background-color: var(--color-card);
    color: var(--color-foreground);
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;

    &:hover {
      background-color: var(--color-primary-light);
      transform: translateY(-2px);
    }

    &.nav-next {
      text-align: right;
      align-items: flex-end;
    }
  }

  .nav-label {
    font-size: 0.75rem;
    color: var(--color-muted-foreground);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .nav-title {
    font-weight: 600;
    color: var(--color-primary);
    line-height: 1.3;
  }
</style>
