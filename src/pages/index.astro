---
import RootLayout from "../layouts/RootLayout.astro";
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import siteConfig from '../../content/site.json';
import Card from "@/components/Card.astro";
import PostCard from "../components/PostCard.astro";

const SITE_TITLE = siteConfig.title;
const SITE_DESCRIPTION = siteConfig.description;
const SITE_BIO = siteConfig.bio;
const SITE_AVATAR = siteConfig.avatar;
const socials = (siteConfig as any).socials || [];

const posts = (await getCollection("blog"))
    .filter((post) => post.data.pinned)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recentPosts = (await getCollection("blog"))
    .filter((post) => !post.data.draft && !post.data.pinned)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
    .slice(0, 3);
---

<RootLayout title={SITE_TITLE} description={SITE_DESCRIPTION} width="md">
    <Card id="avatar-bio">
        <img class="big-avatar" src={SITE_AVATAR} alt="Avatar"/>
        <section id="bio">
            <h2 class="emphasize">
                {SITE_TITLE}
            </h2>
            <p>
                {SITE_BIO}
            </p>
            <div>
                <p>
                    <strong> Contact me: </strong>
                </p>
                <div id="contact">
                    {
                        socials.map((social: any) => (
                            <a
                                class="icon-link"
                                href={social.url}
                                target="_blank"
                                aria-label={social.name}
                            >
                                {social.image ? (
                                    <img
                                        src={social.image}
                                        alt={`${social.name} Logo`}
                                        width={32}
                                        height={32}
                                        style={{ borderRadius: '50%' }}
                                    />
                                ) : (
                                    <Icon
                                        name={social.icon}
                                        width={32}
                                        height={32}
                                    />
                                )}
                            </a>
                        ))
                    }
                </div>
            </div>
        </section>
    </Card>

    <Card>
        <h3>Pinned Posts</h3>
    </Card>
    <section id="pinned-container">
        {
            posts.map((post) => (
                <PostCard {...post.data} slug={post.id} />
            ))
        }
    </section>

    <Card>
        <h3>Recent Posts</h3>
    </Card>
    <section id="recent-container">
        {
            recentPosts.map((post) => (
                <PostCard {...post.data} slug={post.id} />
            ))
        }
    </section>
</RootLayout>

<style>
    /* 注意：<main> 属于 RootLayout，这里不能用 `main > *` 之类的 scoped 选择器
       （会编译成 main[data-astro-cid-j7pv25f6]，而 main 没有这个 cid，永不匹配）。
       块间距直接用各元素自身的 scoped 规则实现。 */

    #avatar-bio {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 3rem;
        margin-top: 3rem;
        margin-bottom: 3rem;
    }

    .big-avatar {
        width: 15rem;
        height: 15rem;
        border-radius: 50%;
    }

    #bio {
        max-width: 20rem;
    }

    @media (max-width: 700px) {
        #avatar-bio {
            flex-direction: column;
        }

        #bio {
            max-width: 100%;
        }
    }

    #bio > p {
        line-height: 1.5;
        letter-spacing: 0.02rem;
        white-space: pre-line;
    }

    #bio > * {
        margin-bottom: 0.75rem;
    }

    #bio > *:last-child {
        margin-bottom: 0;
    }

    #contact {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 0.25rem;
        gap: 0.5rem;
    }

    .icon-link {
        display: block;
        height: 2rem;
        width: 2rem;
        & > * {
            display: inline;
        }
    }

    [data-icon="simple-icons:misskey"]{
        * {
            color: #A1CA03 !important;
        }
    }

    #pinned-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        margin: 1rem 0 2rem;
    }

    #recent-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }
</style>
